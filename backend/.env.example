# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=tenndalux_db
DB_USER=root
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=3306

# Redis Configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Email Configuration (optional)
MAILER_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@tenndalux.com

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_DAYS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Leads del formulario de la web -----------------------------------------
# Correo(s) a los que llega cada solicitud enviada desde el formulario del home.
# Varios separados por coma. Vacio = no se notifica a nadie; la solicitud igual
# queda guardada y visible en el admin. Configurar también SMTP y remitente;
# backend y Huey deben recargar la misma configuración en el deploy autorizado.
LEADS_NOTIFICATION_EMAILS=
LEADS_NOTIFICATION_SUBJECT_PREFIX=[Tenndalux]
