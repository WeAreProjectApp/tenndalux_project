# API Configuration
# Development only. Production serves the API at /api on the same origin;
# omit this variable there or explicitly set NEXT_PUBLIC_API_URL=/api.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev-only: hosts allowed to fetch /_next/* when the browser runs outside this
# machine (e.g. host-only network VM). Comma-separated.
# NEXT_DEV_ALLOWED_ORIGINS=192.168.56.101

# Google Customer Reviews badge (Merchant Center). Optional: the component
# falls back to the production merchant id when unset.
# NEXT_PUBLIC_GOOGLE_MERCHANT_ID=5538542234
